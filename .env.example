# Optional Pyth Hermes credentials. Never commit real keys.
# When unset, the UI uses labeled local-test Pyth-format quotes.
# PYTH_API_KEY=
# PYTH_HERMES_URL=https://hermes.pyth.network
# STOCKLANA_PYTH_SOURCE=auto

# Optional Jupiter Developer Platform key. Forwarded server-side as x-api-key.
# Leave unset for unauthenticated, rate-limited calls.
JUPITER_API_KEY=

# Override only for tests. Default is https://api.jup.ag
# JUPITER_API_BASE=https://api.jup.ag

# auto: Jupiter first, Backpack markets only if Jupiter is blocked.
# jupiter: never call Backpack.
# backpack: skip Jupiter (debug only; venue symbols, not Solana mints).
STOCKLANA_INVENTORY_SOURCE=auto

# PreStocks recipe catalog. auto tries the live PreStocks API, then a labeled
# recorded PreStocks fixture. live never falls back. fixture skips the network.
# Tessera is a related link-out only and is not fetched here.
# STOCKLANA_RECIPE_SOURCE=auto
# PRESTOCKS_API_URL=https://prestocks.com/api/prestocks
