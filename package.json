{
  "name": "stocklana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "idl:sync": "cp target/idl/basket.json lib/solana/idl/basket.json",
    "idl:check": "cmp -s target/idl/basket.json lib/solana/idl/basket.json",
    "test": "node --test tests/*.test.ts",
